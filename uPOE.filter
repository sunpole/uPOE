# ==============================================================================================================
# uPOE — Path of Exile 1 Loot Filter
# Target: PoE 1 — 3.29 Curse of the Allflame
# Currency system: v0.7 — current price tiers + explicit T2B ~1c attention tier
# Gem system: v0.1 — grey / white / ice-blue hierarchy
# Catalog: NeverSink-compatible numeric section architecture
# Foundation: NeverSink 0-SOFT imported after uPOE custom rules
# Price snapshot: late August 2026, Allflame; market values are approximate and move over time
# Primary market unit: Chaos Orb
# ==============================================================================================================

# IMPORTANT
# Rules are processed top-to-bottom.
# uPOE custom rules always come BEFORE the NeverSink foundation. Once an item matches a uPOE rule,
# it does not fall through to NeverSink. This lets us replace the foundation one numbered category at a time.
# Currency pricing for known currency:
#   TIER 1 / SIMPLE LOW   < 0.9c
#   TIER 2B / ATTENTION   >= 0.9c and < 10c
#   TIER 2A / MEDIUM      >= 10c and < 1 Divine
#   TIER 3 / HIGH         >= 1 Divine
#   TIER 4 / LEAGUE + UNCLASSIFIED = current-league resources and any Stackable Currency not listed above
# T2B is the explicit ~1 Chaos (+/-10%) attention layer requested for everyday valuable drops.
# T2B and T2A both use Sound 14 + Green Triangle size 0. T3 keeps stronger Sound 1 / beam / TOP icons.
# Market prices move. Explicit lists below are a playable snapshot, not a permanent economy database.
# TIER 4 is intentionally conspicuous so a new/unpriced currency cannot silently look like a cheap TIER 1 drop.
# See docs/CATALOG.md for the full numbered project map.

# ==============================================================================================================
# [[1400]] LINKS / RECIPES — uPOE PINK LINK HIERARCHY
# Normal/Magic/Rare linked gear only. Unique items remain upstream so valuable unique styling is not overwritten.
# 4L = dark/cool pink, 5L = brighter pink, 6L = hot pink + Sound 2 + permanent Pink beam.
# Rules are ordered 6L -> 5L -> 4L for clarity and future extension.
# ==============================================================================================================

# [1401] SIX-LINK — HIGH
Show
    Rarity Normal Magic Rare
    LinkedSockets 6
    SetFontSize 45
    SetTextColor 255 170 225 255
    SetBackgroundColor 8 2 7 255
    SetBorderColor 255 80 200 255
    PlayAlertSound 2 300
    PlayEffect Pink

# [1402] FIVE-LINK — MEDIUM
Show
    Rarity Normal Magic Rare
    LinkedSockets 5
    SetFontSize 37
    SetTextColor 240 135 205 255
    SetBackgroundColor 18 7 15 250
    SetBorderColor 185 75 150 255

# [1403] FOUR-LINK — SIMPLE
Show
    Rarity Normal Magic Rare
    LinkedSockets 4
    SetFontSize 32
    SetTextColor 205 125 185 255
    SetBackgroundColor 20 10 17 245
    SetBorderColor 110 55 95 255

# ==============================================================================================================
# [[3000]] GEMS — uPOE GREY / WHITE / ICE-BLUE HIERARCHY
# Inspired by NeverSink's split between exceptional/special gems and quality/levelled gems,
# but intentionally simplified into three stable visual grades.
# ==============================================================================================================

# [3001] GEM TIER 3 — ICE-BLUE — EXCEPTIONAL / TRANSFIGURED / PREMIUM
Show
    Class == "Skill Gems" "Support Gems"
    Exceptional True
    SetFontSize 45
    SetTextColor 228 250 255 255
    SetBackgroundColor 6 11 14 255
    SetBorderColor 130 220 235 255

Show
    Class == "Skill Gems" "Support Gems"
    TransfiguredGem True
    SetFontSize 45
    SetTextColor 228 250 255 255
    SetBackgroundColor 6 11 14 255
    SetBorderColor 130 220 235 255

Show
    Class == "Skill Gems" "Support Gems"
    BaseType "Awakened" "Empower Support" "Enhance Support" "Enlighten Support"
    SetFontSize 45
    SetTextColor 228 250 255 255
    SetBackgroundColor 6 11 14 255
    SetBorderColor 130 220 235 255

Show
    Class == "Skill Gems" "Support Gems"
    GemLevel >= 21
    SetFontSize 45
    SetTextColor 228 250 255 255
    SetBackgroundColor 6 11 14 255
    SetBorderColor 130 220 235 255

Show
    Class == "Skill Gems" "Support Gems"
    Quality >= 23
    SetFontSize 45
    SetTextColor 228 250 255 255
    SetBackgroundColor 6 11 14 255
    SetBorderColor 130 220 235 255

Show
    Class == "Skill Gems" "Support Gems"
    GemLevel >= 20
    Quality >= 20
    SetFontSize 45
    SetTextColor 228 250 255 255
    SetBackgroundColor 6 11 14 255
    SetBorderColor 130 220 235 255

# [3002] GEM TIER 2 — WHITE — VAAL / LEVELLED / QUALITY
Show
    Class == "Skill Gems" "Support Gems"
    BaseType "Vaal"
    SetFontSize 37
    SetTextColor 238 240 242 255
    SetBackgroundColor 12 14 16 250
    SetBorderColor 150 160 168 255

Show
    Class == "Skill Gems" "Support Gems"
    GemLevel >= 18
    SetFontSize 37
    SetTextColor 238 240 242 255
    SetBackgroundColor 12 14 16 250
    SetBorderColor 150 160 168 255

Show
    Class == "Skill Gems" "Support Gems"
    Quality >= 1
    SetFontSize 37
    SetTextColor 238 240 242 255
    SetBackgroundColor 12 14 16 250
    SetBorderColor 150 160 168 255

# [3003] GEM TIER 1 — GREY — ALL REMAINING GEMS
Show
    Class == "Skill Gems" "Support Gems"
    SetFontSize 32
    SetTextColor 155 165 172 255
    SetBackgroundColor 16 18 20 245
    SetBorderColor 78 88 96 255

# ==============================================================================================================
# [[4000]] CURRENCY — CURRENT PRICE HIERARCHY
# ==============================================================================================================

# [4001] TIER 3 / HIGH — CURRENT MARKET TOP 1–5 — BIG GREEN CROSS
Show
    Class == "Stackable Currency"
    BaseType == "Mirror of Kalandra" "Hinekora's Lock" "Mirror Shard" "Veiled Exalted Orb" "Tainted Divine Teardrop"
    SetFontSize 45
    SetTextColor 213 255 60 255
    SetBackgroundColor 3 7 2 255
    SetBorderColor 185 255 45 255
    PlayAlertSound 1 300
    PlayEffect Green
    MinimapIcon 0 Green Cross

# [4002] TIER 3 / HIGH — CURRENT MARKET TOP 6–10 — BIG GREEN CIRCLE
Show
    Class == "Stackable Currency"
    BaseType == "Volatile Vaal Orb" "Reflecting Mist" "Foulborn Exalted Orb" "Orb of Dominance" "Awakener's Orb"
    SetFontSize 45
    SetTextColor 213 255 60 255
    SetBackgroundColor 3 7 2 255
    SetBorderColor 185 255 45 255
    PlayAlertSound 1 300
    PlayEffect Green
    MinimapIcon 0 Green Circle

# [4003] TIER 3 / HIGH — >= 1 DIVINE OR CONSERVATIVE SPECIAL HIGH
Show
    Class == "Stackable Currency"
    BaseType == "Refracting Fog" "Warlord's Exalted Orb" "Crystallised Rancour" "Tailoring Orb" "Tempering Orb" "Fracturing Orb" "Orb of Conflict" "Hunter's Exalted Orb" "Dextral Catalyst" "Tainted Exalted Orb" "Valdo's Puzzle Box" "Eternal Orb" "Divine Orb"
    SetFontSize 45
    SetTextColor 213 255 60 255
    SetBackgroundColor 3 7 2 255
    SetBorderColor 185 255 45 255
    PlayAlertSound 1 300
    PlayEffect Green

# [4004] TIER 2A / MEDIUM — >= 10c AND < 1 DIVINE
Show
    Class == "Stackable Currency"
    BaseType == "Shaper's Exalted Orb" "Elder's Exalted Orb" "Sacred Crystallised Lifeforce" "Veiled Chaos Orb" "Sinistral Catalyst" "Redeemer's Exalted Orb" "Maven's Chisel of Proliferation" "Eldritch Orb of Annulment" "Eldritch Chaos Orb" "Prismatic Catalyst" "Maven's Chisel of Scarabs" "Maven's Chisel of Divination" "Maven's Chisel of Procurement" "Crusader's Exalted Orb" "Grand Eldritch Ember" "Foulborn Regal Orb" "Orb of Annulment" "Fertile Catalyst" "Coin of Desecration" "Coin of Restoration" "Coin of Knowledge" "Coin of Power" "Coin of Skill" "Chaotic Astrolabe" "Deceptive Astrolabe" "Fruiting Astrolabe" "Fungal Astrolabe" "Grasping Astrolabe" "Lightless Astrolabe" "Nameless Astrolabe" "Runic Astrolabe" "Templar Astrolabe" "Timeless Astrolabe" "Sacred Orb" "Tainted Mythic Orb" "Tainted Orb of Fusing" "Ritual Vessel" "Transmutation Shard" "Fracturing Shard" "Flesh of Xesht" "Exceptional Eldritch Ember" "Exceptional Eldritch Ichor" "Orb of Remembrance" "Maven's Chisel of Avarice"
    SetFontSize 37
    SetTextColor 175 230 75 255
    SetBackgroundColor 12 19 10 250
    SetBorderColor 125 175 55 255
    PlayAlertSound 14 300
    MinimapIcon 0 Green Triangle

# [4005] TIER 2B / ~1 CHAOS ATTENTION — >= 0.9c AND < 10c
# Explicit intermediate visual grade: brighter than T1, slightly quieter/smaller than T2A.
# Every item here gets the requested Sound 14 + biggest Green Triangle.
Show
    Class == "Stackable Currency"
    BaseType == "Chaos Orb" "Alteration Shard" "Noxious Catalyst" "Enkindling Orb" "Exalted Orb" "Abrasive Catalyst" "Imbued Catalyst" "Turbulent Catalyst" "Gemcutter's Prism" "Accelerating Catalyst" "Intrinsic Catalyst" "Tainted Armourer's Scrap" "Foulborn Orb of Augmentation" "Eldritch Exalted Orb" "Chromatic Orb" "Stacked Deck" "Tainted Chromatic Orb" "Grand Eldritch Ichor" "Tempering Catalyst" "Unstable Catalyst" "Orb of Unravelling" "Ancient Orb" "Tainted Catalyst" "Tainted Chaos Orb"
    SetFontSize 35
    SetTextColor 158 210 80 255
    SetBackgroundColor 13 19 11 248
    SetBorderColor 98 138 50 255
    PlayAlertSound 14 300
    MinimapIcon 0 Green Triangle

# [4006] TIER 1 / SIMPLE LOW — < 0.9c
Show
    Class == "Stackable Currency"
    BaseType == "Armourer's Scrap" "Blacksmith's Whetstone" "Jeweller's Orb" "Orb of Binding" "Orb of Chance" "Alchemy Shard" "Orb of Transmutation" "Orb of Augmentation" "Portal Scroll" "Scroll of Wisdom" "Orb of Fusing" "Orb of Alchemy" "Orb of Alteration" "Orb of Regret" "Orb of Scouring" "Orb of Unmaking" "Regal Orb" "Instilling Orb" "Blessed Orb" "Glassblower's Bauble" "Tainted Blacksmith's Whetstone" "Tainted Jeweller's Orb" "Greater Eldritch Ichor" "Greater Eldritch Ember" "Lesser Eldritch Ember" "Lesser Eldritch Ichor" "Vaal Orb" "Orb of Intention"
    SetFontSize 32
    SetTextColor 138 190 85 255
    SetBackgroundColor 15 20 14 245
    SetBorderColor 72 100 45 255

