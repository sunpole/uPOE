# ==============================================================================================================
# [[4400]] CURRENCY — DYNAMIC / UNCLASSIFIED TIER 4 FALLBACK
# Any new Stackable Currency not matched by the explicit uPOE Currency rules lands here automatically.
# ==============================================================================================================

Show
    Class == "Stackable Currency"
    SetFontSize 37
    SetTextColor 213 255 60 255
    SetBackgroundColor 5 11 4 255
    SetBorderColor 45 175 215 255
    PlayAlertSound 16 300
    MinimapIcon 1 Green Moon

# ==============================================================================================================
# [[9000]] FOUNDATION — NEVER SINK 0-SOFT
# Full NeverSink 0-SOFT handles every numbered category that uPOE has not customized yet.
# Import is Optional so uPOE remains loadable even if the foundation file is temporarily missing.
# As we redesign a category, its uPOE rules are placed ABOVE this import using the same catalog number.
# ==============================================================================================================

Import "NeverSink-0-SOFT.filter" Optional

# ==============================================================================================================
# [[9999]] FINAL SAFETY FALLBACK
# If neither uPOE nor the imported foundation recognizes an item, keep it visible.
# ==============================================================================================================

Show
    SetFontSize 32
